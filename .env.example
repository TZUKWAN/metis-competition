# METIS Competition 运行配置（复制为 .env 后填写；.env 不要提交到 git）
# LLM（OpenAI 兼容，必填，否则 Agent 与各生成任务无法工作）
COMP_LLM_API_BASE=https://api.openai.com/v1
COMP_LLM_API_KEY=
COMP_LLM_MODEL=
# 联网搜索（serper.dev 或 tavily，二选一必填，否则调研任务无法工作）
SEARCH_API_KEY=
SEARCH_PROVIDER=serper
# 生图（可选；未配置则 images 任务如实标记失败）
IMAGE_API_BASE=
IMAGE_API_KEY=
IMAGE_MODEL=
# 视频（可选；未配置则 video 任务如实标记失败）
VIDEO_API_BASE=
VIDEO_API_KEY=
VIDEO_MODEL=
# 服务端口（可选）
PORT=8787
